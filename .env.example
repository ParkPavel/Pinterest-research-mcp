PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://127.0.0.1:8765/callback
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Scopes are fixed in code to boards:read,pins:read,user_accounts:read.
# Raw token overrides are intentionally unsupported.
